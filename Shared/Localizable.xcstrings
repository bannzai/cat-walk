        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes consultar los Términos de uso y la Política de privacidad y contactarnos desde los Ajustes de Cat Walk en el iPhone"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez consulter les conditions d’utilisation et la politique de confidentialité et nous contacter depuis les réglages de Cat Walk sur l’iPhone"
